rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile rules: authenticated users can read profiles, but write only their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Group helper function: check if authenticated user is a member of the group
    function isGroupMember(groupId) {
      return request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // Groups collection rules
    match /groups/{groupId} {
      // Any authenticated user can read group if they are a member, or query by inviteCode to join
      allow read: if request.auth != null && 
        (resource == null || request.auth.uid in resource.data.members);
      
      // Allow searching for group by invite code when joining
      allow list: if request.auth != null;

      // Authenticated users can create groups if they add themselves as a member
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.members;

      // Group members can update the group, or new members can join if under maxMembers limit (up to 10)
      allow update: if request.auth != null && 
        (request.auth.uid in resource.data.members || 
         (resource.data.members.size() < resource.data.get('maxMembers', 10) && request.auth.uid in request.resource.data.members));

      // Group members can delete the group
      allow delete: if request.auth != null && 
        request.auth.uid in resource.data.members;

      // Month subcollections: only group members can access
      match /months/{monthId} {
        allow read, write: if isGroupMember(groupId);

        // Transaction subcollections: only group members can access
        match /transactions/{transactionId} {
          allow read, write: if isGroupMember(groupId);
        }
      }

      // Cash pending amount & transactions subcollections: only group members can access
      match /cash/{docId} {
        allow read, write: if isGroupMember(groupId);
      }
      match /cash_transactions/{transactionId} {
        allow read, write: if isGroupMember(groupId);
      }
    }
  }
}
